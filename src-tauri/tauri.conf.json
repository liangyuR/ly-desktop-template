{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ly Desktop",
  "version": "0.1.0",
  "identifier": "com.liangyur.lydesktoptemplate",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ly Desktop",
        "width": 1216,
        "height": 800,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": { "pubkey": "" }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
